      "catalogue": [
        44,
        45,
        4
      ],
      "drivers": [
        {
          "name": "Drought and heat",
          "catalogue": [
            45
          ]
        },
        {
          "name": "Fires set for pasture clearing",
          "catalogue": [
            44
          ]
        }
      ],
      "sites": [
        "The northern Pantanal wetlands",
        "Hyacinth macaw nesting palms",
        "A jaguar refuge"
      ],
      "fact": {
        "text": "An INPE-led study estimated that fires in the 2020 drought burned about 30% of the Brazilian Pantanal, the world’s largest tropical freshwater wetland.",
        "source": "Agência FAPESP, on the INPE study of the 2020 Pantanal fires",
        "url": "https://agencia.fapesp.br/in-2020-30-of-the-pantanal-was-burned-to-cinders-by-wildfires/49974",
        "also": [
          {
            "source": "Space.com (19 October 2023)",
            "url": "https://space.com/2020-wildfires-brazil-pantanal-satellite-data"
          }
        ],
        "checked": "2026-10-29"
      },
      "realWorld": "Follow local fire bans, never burn rubbish in dry weather, and support wetland restoration groups and firefighting volunteers.",
      "mission": "la-pantanal"
    },
    {
      "id": "la-parana-pine-issue",
      "title": "The Last Araucaria Forests",
      "theme": "plants",
      "tier": 1,
      "driver": "land-sea-use",
      "priority": {
        "severity": 5,
        "urgency": 3,
        "irreversibility": 5,
