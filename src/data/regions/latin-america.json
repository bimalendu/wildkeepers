      "drivers": [
        {
          "name": "Chytrid fungus (Batrachochytrium dendrobatidis)",
          "catalogue": [
            68
          ]
        },
        {
          "name": "Habitat loss and fragmentation",
          "catalogue": [
            11
          ]
        },
        {
          "name": "Climate stress on mountain amphibians",
          "catalogue": [
            46
          ]
        }
      ],
      "sites": [
        "A cloud-forest stream",
        "A captive assurance colony",
        "The harlequin toads of the Andes",
        "The golden frog"
      ],
      "fact": {
        "text": "A 2019 study in Science found chytrid fungus has driven declines in at least 501 amphibian species, and 90 of them are thought to be extinct.",
        "source": "Scheele et al., Science (2019)",
        "url": "https://doi.org/10.1126/science.aav0379",
        "checked": "2026-10-29"
      },
      "realWorld": "Clean boots, nets and gear between wetlands, never release pet amphibians into the wild, and support amphibian rescue programmes.",
      "mission": "la-chytrid"
    },
    {
      "id": "la-pantanal-issue",
      "title": "Pantanal on Fire",
      "theme": "climate",
      "tier": 1,
      "driver": "climate",
      "priority": {
        "severity": 4,
        "urgency": 5,
        "irreversibility": 4,
        "reach": 3
